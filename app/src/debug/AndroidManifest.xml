<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay. The debug build talks to `wrangler dev` on the machine that runs adb, reached
  through `adb reverse tcp:8787 tcp:8787`, which is plain HTTP on the loopback interface. Release
  builds carry neither this attribute nor the endpoint, so no cleartext permission ships to a user.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
