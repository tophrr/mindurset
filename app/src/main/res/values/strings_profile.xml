    <!-- Data & consent -->
    <string name="consent_title">Data &amp; consent</string>
    <string name="consent_heading">Your data, your rules</string>
    <string name="consent_intro">Mind-Ur-Set keeps your check-ins and reflections on this device only. There is no account server and no cloud sync in this build.</string>
    <string name="consent_bullet_local">Everything you record is stored locally on this phone.</string>
    <string name="consent_bullet_no_server">Nothing is uploaded to a server, and nothing is shared with third parties.</string>
    <string name="consent_bullet_delete">You can erase your local data at any time using Log out and delete local data.</string>
    <string name="consent_footer">Because the data lives only here, uninstalling the app or clearing its storage also clears everything. Keep a backup of anything you would not want to lose.</string>

